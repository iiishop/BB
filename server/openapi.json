  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "account": {
            "type": "string",
            "pattern": "^[1-9][0-9]{7}$",
            "title": "Account"
          },
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "account",
          "username"
        ],
        "title": "AccountResponse"
      },
      "AvatarResponse": {
        "properties": {
          "avatar_url": {
            "type": "string",
            "pattern": "^/avatars/[1-9][0-9]{7}\\.png$",
            "title": "Avatar Url"
          },
          "avatar_version": {
            "type": "string",
            "minLength": 1,
            "title": "Avatar Version"
          }
        },
        "type": "object",
        "required": [
          "avatar_url",
          "avatar_version"
        ],
        "title": "AvatarResponse"
      },
      "Body_upload_avatar_me_avatar_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_avatar_me_avatar_post"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array",
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "FieldError"
      },
      "HeartbeatResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "online",
            "title": "Status",
            "default": "online"
          },
          "last_seen_at": {
            "type": "string",
            "title": "Last Seen At"
          }
        },
        "type": "object",
        "required": [
          "last_seen_at"
        ],
        "title": "HeartbeatResponse"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "type": "string",
            "title": "Password",
            "writeOnly": true
          },
          "account": {
            "type": "string",
            "title": "Account",
            "description": "Eight ASCII digits; server allocates 10000000–99999999"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password",
          "account"
        ],
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "account": {
            "type": "string",
            "pattern": "^[1-9][0-9]{7}$",
            "title": "Account"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "account",
          "username",
          "token"
        ],
        "title": "LoginResponse"
      },
      "ProfilePatch": {
        "properties": {
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username",
            "description": "Omit to preserve; null rejected; trim to 3–24 code points"
          },
          "signature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signature",
            "description": "Omit to preserve; null/trimmed empty clears; at most 49 code points"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ProfilePatch"
      },
      "ProfileResponse": {
        "properties": {
          "avatar_url": {
            "type": "string",
            "pattern": "^/avatars/[1-9][0-9]{7}\\.png$",
            "title": "Avatar Url"
          },
          "avatar_version": {
            "type": "string",
            "minLength": 1,
            "title": "Avatar Version"
          },
          "account": {
            "type": "string",
            "pattern": "^[1-9][0-9]{7}$",
            "title": "Account"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "signature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signature"
          }
        },
        "type": "object",
        "required": [
          "avatar_url",
          "avatar_version",
          "account",
          "username",
          "signature"
        ],
        "title": "ProfileResponse"
      },
      "RegisterRequest": {
        "properties": {
          "password": {
            "type": "string",
            "title": "Password",
            "description": "At least 6 characters, with ASCII A–Z, a–z and 0–9; never trimmed",
            "writeOnly": true
          },
          "username": {
            "type": "string",
            "title": "Username",
            "description": "Trimmed display name, 3–24 characters; duplicates allowed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password",
          "username"
        ],
        "title": "RegisterRequest"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
