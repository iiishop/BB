{
  "name": "bb-admin-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BB local management UI (DEA-469). Consumes server/contract/admin-openapi.json.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:review-probes": "vitest run --config vitest.review.config.ts",
    "test:e2e": "node e2e/prepare.mjs && playwright test",
    "test:e2e:real": "node e2e/prepare.mjs && playwright test --grep @real-a",
    "test:e2e:preview": "node e2e/prepare.mjs && playwright test --grep @b-preview",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
